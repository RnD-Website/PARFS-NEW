import { commerce } from "@/lib/commerce";
import { aiSection, featured, hero } from "@/content/home";
import { Hero } from "@/components/sections/home/hero";
import { About } from "@/components/sections/home/about";
import { ShopByCategory } from "@/components/sections/home/shop-by-category";
import { AIAssistantSection } from "@/components/sections/home/ai-assistant";
import { BestSellers } from "@/components/sections/home/best-sellers";
import { SalePromo } from "@/components/sections/home/sale-promo";
import { FeaturedProduct } from "@/components/sections/home/featured-product";
import { Reviews } from "@/components/sections/home/reviews";
import { FAQSection } from "@/components/sections/home/faq";
import { Services } from "@/components/sections/home/services";
import { JsonLd, organizationJsonLd, faqJsonLd } from "@/lib/seo/json-ld";

export const revalidate = 300;

export default async function HomePage() {
  const [categories, best, featuredProduct, aiProducts] = await Promise.all([
    commerce.getCategories(),
    commerce.getProducts({ bestSellers: true, pageSize: 24, sort: "featured" }),
    commerce.getProduct(featured.slug),
    commerce.getProducts({ slugs: aiSection.demo.picks.map((p) => p.slug), pageSize: 6 }),
  ]);
  const aiFull = await commerce.getProductsByIds(aiProducts.items.map((p) => p.id));

  const floating = best.items.find((p) => p.slug === hero.floatingProductSlug) ?? null;
  const picks = aiSection.demo.picks
    .map((d) => {
      const product = aiProducts.items.find((p) => p.slug === d.slug);
      const full = aiFull.find((p) => p.slug === d.slug);
      if (!product || !full) return null;
      const v = full.variants.find((x) => x.options.Size === d.size && (!d.color || x.options.Color === d.color) && x.stock > 0);
      return { product, title: d.title, note: d.note, image: d.image, variantId: v?.id ?? null, variantTitle: v?.title ?? null };
    })
    .filter((x): x is NonNullable<typeof x> => !!x);

  return (
    <>
      <JsonLd data={[organizationJsonLd(), faqJsonLd()]} />
      <Hero floating={floating} />
      <About />
      <ShopByCategory categories={categories} />
      <AIAssistantSection picks={picks} />
      <BestSellers products={best.items} />
      <SalePromo />
      {featuredProduct && <FeaturedProduct product={featuredProduct} />}
      <Reviews />
      <FAQSection />
      <Services />
    </>
  );
}
