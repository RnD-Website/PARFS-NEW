# ─────────────────────────────────────────────────────────────
# GASENOS environment variables. Copy to .env for local dev.
# In Netlify: Site configuration → Environment variables
# (scope: Builds + Functions). Changes need a redeploy.
# Never prefix secrets with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used in emails, payment callbacks, SEO)
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# PostgreSQL — use the POOLED connection string for serverless (Neon/Supabase/RDS).
# With Netlify Database, NETLIFY_DB_URL is provided automatically and used as fallback.
DATABASE_URL="postgresql://user:password@host:5432/gasenos?sslmode=require"

# Long random string (sessions, signed order links). Generate: openssl rand -base64 48
AUTH_SECRET=""

# Catalogue backend: prisma (default). Future: shopify
COMMERCE_PROVIDER="prisma"

# ── GASENOS AI ──
# mock = rule-based assistant over the real catalogue (no key needed)
# anthropic = Claude with tool use over the catalogue
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
# Optional overrides
AI_MODEL="claude-opus-5-5"
AI_EFFORT="low"

# ── Payments ──
# mock = TEST MODE gateway (no money moves) | sslcommerz = live/sandbox SSLCommerz
PAYMENT_PROVIDER="mock"
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
# true = sandbox.sslcommerz.com, false = live securepay.sslcommerz.com
SSLCOMMERZ_SANDBOX="true"

# ── Email ──
# console = log emails (dev) | resend = send via Resend
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM="GASENOS <orders@example.com>"
# Receives contact-form messages
SUPPORT_EMAIL=""

# Local test customer (created in the local dev database while testing the PARFS sign-in drawer).
# Test values only — never use on a live site.
# PARFS_TEST_EMAIL="parfs.drawer.test@example.com"
# PARFS_TEST_PASSWORD="Parfs-drawer-2026"
